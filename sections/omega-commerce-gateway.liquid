{% comment %}
  OMEGA HOUSE BEATS — Commerce Engine V2
  Staged homepage section. No external JS, no autoplay, no unverifiable
  discount/remaining-inventory copy. Assumes current active $5 starter.
  Intentionally does not link to future/unverified sample/plugin collections.
{% endcomment %}
{% liquid
  assign starter = section.settings.featured_product
  if starter == blank
    assign starter = all_products['flagship-producer-starter']
  endif
  assign starter_variant = starter.selected_or_first_available_variant
%}
<section id="OmegaCommerce-{{ section.id }}" class="omega-commerce-v2" aria-labelledby="OmegaCommerceHeading-{{ section.id }}">
  <div class="omega-commerce-v2__inner">
    <div class="omega-commerce-v2__hero">
      <p class="omega-commerce-v2__eyebrow">OMEGA HOUSE BEATS · ORIGINAL PRODUCTION SYSTEMS</p>
      <h2 id="OmegaCommerceHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      <p class="omega-commerce-v2__summary">{{ section.settings.subheading | escape }}</p>
      <div class="omega-commerce-v2__actions">
        {% if starter != blank %}
          <a class="omega-commerce-v2__button" href="{{ starter.url }}">Explore the {{ starter.price_min | money }} Producer Starter <span aria-hidden="true">↗</span></a>
        {% endif %}
        <a class="omega-commerce-v2__secondary" href="{{ section.settings.beats_url | default: '/collections/beats-licenses' }}">Browse beats &amp; licenses <span aria-hidden="true">↗</span></a>
      </div>
      <p class="omega-commerce-v2__small">Hear the sound. Understand the license. Choose the right tools.</p>
    </div>
    {% if starter != blank %}
      <article class="omega-commerce-v2__feature" aria-label="Featured first purchase">
        {% if starter.featured_image != blank %}
          {{ starter.featured_image | image_url: width: 560 | image_tag: loading: 'lazy', widths: '280,420,560', sizes: '(max-width: 760px) 90vw, 360px', alt: starter.title, class: 'omega-commerce-v2__cover' }}
        {% endif %}
        <div class="omega-commerce-v2__feature-content">
          <p class="omega-commerce-v2__eyebrow">YOUR FIRST SESSION</p>
          <h3>{{ starter.title | escape }}</h3>
          {% if starter_variant != blank %}
            <p class="omega-commerce-v2__price">{{ starter_variant.price | money }}</p>
          {% endif %}
          <p class="omega-commerce-v2__small">Product details, previews, included files and rights are shown before checkout.</p>
          <a href="{{ starter.url }}" class="omega-commerce-v2__text-link">Preview &amp; view license <span aria-hidden="true">↗</span></a>
        </div>
      </article>
    {% endif %}
  </div>
  <nav aria-label="Shop by what you are making" class="omega-commerce-v2__lanes">
    <a href="{{ section.settings.beats_url | default: '/collections/beats-licenses' }}"><strong>Find a beat</strong><span>Hear music and choose licensed rights</span><span aria-hidden="true">↗</span></a>
    {% if section.settings.samples_url != blank %}
      <a href="{{ section.settings.samples_url }}"><strong>Build with sounds</strong><span>Browse sample and production packs</span><span aria-hidden="true">↗</span></a>
    {% endif %}
    {% if section.settings.plugins_url != blank %}
      <a href="{{ section.settings.plugins_url }}"><strong>Use studio tools</strong><span>Explore verified plugins and engineering tools</span><span aria-hidden="true">↗</span></a>
    {% endif %}
  </nav>
</section>
<style>
  #OmegaCommerce-{{ section.id }}{--omega-ink:#0c0912;--omega-white:#f2eaf5;--omega-muted:#c9bed0;--omega-line:#493851;--omega-gold:#f2c88c;background:var(--omega-ink);color:var(--omega-white);padding:clamp(28px,5vw,64px) max(16px,calc((100vw - 1200px)/2));font-family:inherit;}
  #OmegaCommerce-{{ section.id }} *{box-sizing:border-box}
  #OmegaCommerce-{{ section.id }} .omega-commerce-v2__inner{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(270px,1fr);gap:clamp(20px,4vw,54px);align-items:center}
  #OmegaCommerce-{{ section.id }} .omega-commerce-v2__eyebrow{font-size:12px;letter-spacing:.14em;color:#d8b1e9;font-weight:700;margin:0 0 12px}
  #OmegaCommerce-{{ section.id }} h2{font-size:clamp(32px,5vw,64px);line-height:1.06;letter-spacing:-.04em;color:var(--omega-gold);margin:0 0 20px}
  #OmegaCommerce-{{ section.id }} .omega-commerce-v2__summary{font-size:clamp(16px,2vw,20px);line-height:1.5;color:var(--omega-muted);max-width:55ch}
  #OmegaCommerce-{{ section.id }} .omega-commerce-v2__actions{display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin:24px 0}
  #OmegaCommerce-{{ section.id }} a{color:inherit;text-decoration:none}
  #OmegaCommerce-{{ section.id }} .omega-commerce-v2__button{background:var(--omega-gold);color:#16111a;padding:14px 20px;border-radius:7px;min-height:48px;display:inline-flex;align-items:center;font-weight:700}
  #OmegaCommerce-{{ section.id }} .omega-commerce-v2__secondary{padding:12px 8px;text-decoration:underline;text-underline-offset:4px;min-height:48px;display:inline-flex;align-items:center}
  #OmegaCommerce-{{ section.id }} .omega-commerce-v2__small{font-size:13px;line-height:1.55;color:var(--omega-muted)}
  #OmegaCommerce-{{ section.id }} .omega-commerce-v2__feature{border:1px solid var(--omega-line);border-radius:12px;overflow:hidden;background:#1a1322}
  #OmegaCommerce-{{ section.id }} .omega-commerce-v2__cover{display:block;width:100%;height:auto;max-height:240px;object-fit:cover}
  #OmegaCommerce-{{ section.id }} .omega-commerce-v2__feature-content{padding:20px}
  #OmegaCommerce-{{ section.id }} h3{color:var(--omega-white);font-size:20px;line-height:1.3;margin:0 0 6px}
  #OmegaCommerce-{{ section.id }} .omega-commerce-v2__price{font-size:24px;color:var(--omega-gold);font-weight:700;margin:6px 0}
  #OmegaCommerce-{{ section.id }} .omega-commerce-v2__text-link{text-decoration:underline;text-underline-offset:4px}
  #OmegaCommerce-{{ section.id }} .omega-commerce-v2__lanes{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:32px}
  #OmegaCommerce-{{ section.id }} .omega-commerce-v2__lanes a{border:1px solid var(--omega-line);border-radius:8px;padding:14px;min-height:80px;display:flex;flex-direction:column;gap:3px}
  #OmegaCommerce-{{ section.id }} .omega-commerce-v2__lanes a strong{font-size:16px}
  #OmegaCommerce-{{ section.id }} .omega-commerce-v2__lanes a span{font-size:13px;color:var(--omega-muted)}
  #OmegaCommerce-{{ section.id }} :is(a):focus-visible{outline:3px solid var(--omega-gold);outline-offset:3px}
  @media(max-width:760px){#OmegaCommerce-{{ section.id }} .omega-commerce-v2__inner{grid-template-columns:1fr}#OmegaCommerce-{{ section.id }} .omega-commerce-v2__lanes{grid-template-columns:1fr}#OmegaCommerce-{{ section.id }} .omega-commerce-v2__feature{display:flex;align-items:center}#OmegaCommerce-{{ section.id }} .omega-commerce-v2__cover{width:37%;max-height:220px}#OmegaCommerce-{{ section.id }} .omega-commerce-v2__feature-content{padding:14px}}
  @media(prefers-reduced-motion:reduce){#OmegaCommerce-{{ section.id }}{scroll-behavior:auto}}
</style>
{% schema %}
{
  "name": "Omega Commerce V2 Gateway",
  "tag": "section",
  "class": "omega-commerce-v2-section",
  "settings": [
    {"type":"text","id":"heading","label":"Hero heading","default":"Original sound. Clear rights. Your next session."},
    {"type":"text","id":"subheading","label":"Supporting promise","default":"Cinematic beats, focused sample libraries and studio tools for the music you're building."},
    {"type":"product","id":"featured_product","label":"Featured first-purchase product"},
    {"type":"url","id":"beats_url","label":"Verified beats collection"},
    {"type":"url","id":"samples_url","label":"Verified sample packs collection"},
    {"type":"url","id":"plugins_url","label":"Verified tools or plugins collection"}
  ],
  "presets":[{"name":"Omega Commerce V2 Gateway"}]
}
{% endschema %}
